# =============================================================================
# Inspectra AI — environment template
# Copy to .env (root) and apps/*/.env.local as needed. Never commit secrets.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Apps ---
# Local: http://localhost:3000 — Production (Render): https://inspectra-tan.vercel.app
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
AI_SERVICE_URL=http://localhost:4100
AI_SERVICE_PORT=4100
ORCHESTRATOR_TASK_QUEUE=inspectra-scans

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://inspectra:inspectra@localhost:5432/inspectra?schema=public
DATABASE_SHADOW_URL=postgresql://inspectra:inspectra@localhost:5432/inspectra_shadow?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=inspectra
S3_SECRET_ACCESS_KEY=inspectrasecret
S3_BUCKET_ARTIFACTS=inspectra-artifacts
S3_FORCE_PATH_STYLE=true

# --- Auth ---
AUTH_PROVIDER=password
AUTH_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SEC=3600
SESSION_REFRESH_DAYS=30

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PRICE_STARTER=

# --- AI providers (OpenAI-compatible) ---
# Pick one: openai | openrouter | gemini | auto | stub
# AI_PROVIDER=auto
# AI_DEFAULT_PROVIDER=auto
#
# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
#
# OpenRouter (https://openrouter.ai)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# OPENROUTER_SITE_URL=https://inspectra-tan.vercel.app
# OPENROUTER_APP_NAME=Inspectra AI
#
# Inspectra Studio plans (optional Stripe Price IDs)
# STRIPE_PRICE_STUDIO_WEEKLY=
# STRIPE_PRICE_STUDIO_MONTHLY=
# STRIPE_PRICE_STUDIO_CUSTOM_DAY=
# Google Gemini (OpenAI-compatible endpoint)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash
#
# Optional overrides
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_VISION_MODEL=
# --- Unlimited owner (seeded on API boot) ---
# SEED_OWNER=false
# SEED_OWNER_EMAIL=qadirdadkazi@gmail.com
# SEED_OWNER_PASSWORD=PASSWORD12345
# FREE_SIGNUP_AUDIT_CREDITS=1

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Security / edge ---
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=30
ENABLE_SWAGGER=false

# --- Backups ---
# BACKUP_DIR=./backups
# RETENTION_DAYS=14
# S3_BACKUP_URI=s3://inspectra-backups/postgres
# S3_BACKUP_SRC=s3://inspectra-artifacts
# S3_BACKUP_DST=s3://inspectra-artifacts-dr

# --- Feature flags ---
FEATURE_AI_TRIAGE=false
FEATURE_SAAS_AUDITS=false
