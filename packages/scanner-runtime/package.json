{
  "name": "@inspectra/scanner-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@inspectra/logger": "workspace:*"
  },
  "devDependencies": {
    "@inspectra/tsconfig": "workspace:*",
    "eslint": "^10.8.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
