// Inspectra AI — normalized PostgreSQL schema (Prisma)
// Source of truth for control-plane data. RLS policies added in a later hardening phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AssetType {
  web
  android
  ios
  msstore
  api
  extension
  saas
}

enum AuditStatus {
  draft
  pending
  queued
  running
  succeeded
  failed
  cancelled
  timed_out
}

enum AuditStageStatus {
  pending
  running
  succeeded
  failed
  skipped
}

enum FindingSeverity {
  critical
  high
  medium
  low
  info
}

enum TriageStatus {
  open
  confirmed
  false_positive
  accepted_risk
  fixed
}

enum MembershipRole {
  owner
  admin
  analyst
  viewer
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ReportFormat {
  pdf
  sarif
  json
  csv
  html
}

enum ReportStatus {
  pending
  generating
  ready
  failed
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

enum BillingInterval {
  month
  year
}

enum UsageMetric {
  audit_minutes
  seats
  ai_tokens
  report_exports
}

enum NotificationChannel {
  in_app
  email
  webhook
  slack
}

enum NotificationStatus {
  pending
  sent
  failed
  read
}

enum JobType {
  run_audit
  generate_report
  send_notification
  sync_billing
  run_schedule
  sync_integration
}

enum JobStatus {
  pending
  queued
  active
  completed
  failed
  cancelled
}

enum AuthProvider {
  password
  workos
  clerk
  google
  github
  saml
}

// ---------------------------------------------------------------------------
// Identity & authentication
// ---------------------------------------------------------------------------

/// Platform user (global identity). Org access is via Membership.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  /// bcrypt hash for email/password auth; null when OAuth-only.
  passwordHash    String?
  name            String?
  imageUrl        String?
  isActive        Boolean   @default(true)
  /// Platform operator (Inspectra internal admin panel).
  isPlatformAdmin Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  identities              AuthIdentity[]
  sessions                Session[]
  memberships             Membership[]
  invitationsSent         Invitation[]              @relation("InvitationInviter")
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  auditJobsRequested      JobRun[]                  @relation("JobRequestedBy")
  findingTriages          FindingTriageEvent[]
  auditComments           AuditComment[]
  schedulesCreated        AuditSchedule[]           @relation("ScheduleCreator")
  screenshotProjects      ScreenshotStudioProject[]

  @@index([isActive])
  @@index([isPlatformAdmin])
  @@map("users")
}

/// Links a User to an external IdP subject (WorkOS/Clerk/SAML/OAuth).
model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  providerEmail  String?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

/// Server-side session for cookie/Bearer session tokens (not API keys).
model Session {
  id               String    @id @default(cuid())
  userId           String
  tokenHash        String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Organizations / tenancy
// ---------------------------------------------------------------------------

/// Billing and security tenant boundary.
model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  /// Default data residency hint (e.g. us, eu).
  region             String   @default("us")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  settings            OrganizationSettings?
  memberships         Membership[]
  invitations         Invitation[]
  workspaces          Workspace[]
  assets              Asset[]
  audits              Audit[]
  reports             Report[]
  apiKeys             ApiKey[]
  integrations        Integration[]
  webhookEndpoints    WebhookEndpoint[]
  billingCustomer     BillingCustomer?
  subscriptions       Subscription[]
  usageRecords        UsageRecord[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  jobRuns             JobRun[]
  findingSuppressions FindingSuppression[]
  aiMemoryEntries     AiMemoryEntry[]
  auditSchedules      AuditSchedule[]
  workflowLogs        WorkflowLog[]
  auditComments       AuditComment[]
  screenshotProjects  ScreenshotStudioProject[]

  @@index([isActive])
  @@map("organizations")
}

/// 1:1 org configuration (SSO flags, retention, feature entitlements cache).
model OrganizationSettings {
  organizationId       String   @id
  retentionDays        Int      @default(90)
  allowAiTriage        Boolean  @default(true)
  requireMfa           Boolean  @default(false)
  ssoEnforced          Boolean  @default(false)
  allowedEmailDomains  String[] @default([])
  metadata             Json     @default("{}")
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// User ↔ Organization RBAC membership.
model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(viewer)
  invitedById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("memberships")
}

/// Pending org invites (email may not yet map to a User).
model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole   @default(viewer)
  tokenHash      String           @unique
  status         InvitationStatus @default(pending)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([email])
  @@map("invitations")
}

/// Optional nesting under an organization for asset grouping.
model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets       Asset[]
  audits       Audit[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

// ---------------------------------------------------------------------------
// Assets & audits
// ---------------------------------------------------------------------------

/// Auditable target (URL, package, store ID, OpenAPI URL, etc.).
model Asset {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String?
  type           AssetType
  name           String
  /// Canonical identifier (URL, bundle id, package name, store id).
  identifier     String
  environment    String    @default("production")
  metadata       Json      @default("{}")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  credentials  AssetCredential?
  audits       Audit[]
  aiMemoryEntries AiMemoryEntry[]
  schedules    AuditSchedule[]

  @@unique([organizationId, type, identifier])
  @@index([organizationId, type])
  @@index([workspaceId])
  @@map("assets")
}

/// Vault reference for authenticated SaaS/API audits (never store raw secrets).
model AssetCredential {
  id              String    @id @default(cuid())
  assetId         String    @unique
  vaultSecretRef  String
  label           String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_credentials")
}

/// One audit run against an asset (immutable config snapshot).
model Audit {
  id              String      @id @default(cuid())
  organizationId  String
  workspaceId     String?
  assetId         String
  status          AuditStatus @default(pending)
  /// Frozen scan configuration at enqueue time.
  config          Json        @default("{}")
  triggeredById   String?
  workflowId      String?
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  /// Billable compute minutes once completed.
  durationMinutes Decimal?    @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  stages       AuditStage[]
  events       AuditEvent[]
  findings     Finding[]
  reports      Report[]
  jobRuns      JobRun[]
  aiMemoryEntries AiMemoryEntry[]
  comments     AuditComment[]

  @@index([organizationId, status])
  @@index([assetId])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("audits")
}

/// Pipeline stage within an audit (crawl, static, AI triage, etc.).
model AuditStage {
  id          String           @id @default(cuid())
  auditId     String
  name        String
  status      AuditStageStatus @default(pending)
  position    Int
  startedAt   DateTime?
  finishedAt  DateTime?
  errorMessage String?
  metadata    Json             @default("{}")

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, name])
  @@index([auditId, position])
  @@map("audit_stages")
}

/// Append-only progress / diagnostic events for an audit.
model AuditEvent {
  id        String   @id @default(cuid())
  auditId   String
  type      String
  message   String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
  @@map("audit_events")
}

/// Normalized finding produced by scanners / AI.
model Finding {
  id           String          @id @default(cuid())
  auditId      String
  fingerprint  String
  title        String
  description  String          @default("")
  severity     FindingSeverity
  category     String
  location     String?
  cweId        String?
  cvssScore    Decimal?        @db.Decimal(4, 1)
  evidenceRefs Json            @default("[]")
  remediation  String?
  triageStatus TriageStatus    @default(open)
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  audit         Audit                @relation(fields: [auditId], references: [id], onDelete: Cascade)
  triageEvents  FindingTriageEvent[]

  @@unique([auditId, fingerprint])
  @@index([auditId, severity])
  @@index([auditId, triageStatus])
  @@map("findings")
}

/// Audit trail of triage decisions on a finding.
model FindingTriageEvent {
  id         String       @id @default(cuid())
  findingId  String
  actorId    String?
  fromStatus TriageStatus
  toStatus   TriageStatus
  note       String?
  createdAt  DateTime     @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([findingId, createdAt])
  @@map("finding_triage_events")
}

/// Org-level suppression rule keyed by fingerprint/pattern.
model FindingSuppression {
  id             String    @id @default(cuid())
  organizationId String
  fingerprint    String?
  pattern        String?
  reason         String
  createdById    String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, fingerprint])
  @@map("finding_suppressions")
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

model Report {
  id             String       @id @default(cuid())
  organizationId String
  auditId        String
  format         ReportFormat
  status         ReportStatus @default(pending)
  title          String
  storageKey     String?
  checksumSha256 String?
  byteSize       Int?
  errorMessage   String?
  requestedById  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  readyAt        DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit            @relation(fields: [auditId], references: [id], onDelete: Cascade)
  artifacts    ReportArtifact[]
  jobRuns      JobRun[]

  @@index([organizationId, status])
  @@index([auditId])
  @@map("reports")
}

/// Additional files attached to a report (charts, annexes).
model ReportArtifact {
  id         String   @id @default(cuid())
  reportId   String
  name       String
  contentType String
  storageKey String
  byteSize   Int?
  createdAt  DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_artifacts")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model BillingCustomer {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  stripeCustomerId String   @unique
  email            String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_customers")
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  stripeSubscriptionId   String             @unique
  stripePriceId          String
  status                 SubscriptionStatus
  interval               BillingInterval    @default(month)
  seatQuantity           Int                @default(1)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("subscriptions")
}

model UsageRecord {
  id             String      @id @default(cuid())
  organizationId String
  metric         UsageMetric
  quantity       Decimal     @db.Decimal(18, 4)
  /// Idempotency key for Stripe usage records / internal meters.
  idempotencyKey String      @unique
  periodStart    DateTime
  periodEnd      DateTime
  sourceType     String?
  sourceId       String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, periodStart])
  @@map("usage_records")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String?
  channel        NotificationChannel
  status         NotificationStatus  @default(pending)
  title          String
  body           String
  payload        Json                @default("{}")
  dedupeKey      String?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  channel        NotificationChannel
  eventType      String
  enabled        Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, channel, eventType])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// API keys, integrations, webhooks, jobs
// ---------------------------------------------------------------------------

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String
  keyHash        String    @unique
  scopes         String[]  @default([])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  status         String   @default("active")
  config         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@map("integrations")
}

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secretHash     String
  eventTypes     String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("webhook_endpoints")
}

/// Durable background job tracking (BullMQ/Temporal correlation).
model JobRun {
  id              String    @id @default(cuid())
  organizationId  String
  type            JobType
  status          JobStatus @default(pending)
  queueName       String
  externalJobId   String?
  auditId         String?
  reportId        String?
  requestedById   String?
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  input           Json      @default("{}")
  output          Json      @default("{}")
  errorMessage    String?
  scheduledFor    DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit?       @relation(fields: [auditId], references: [id], onDelete: SetNull)
  report       Report?      @relation(fields: [reportId], references: [id], onDelete: SetNull)
  requestedBy  User?        @relation("JobRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([organizationId, type, status])
  @@index([externalJobId])
  @@index([auditId])
  @@index([reportId])
  @@map("job_runs")
}

/// Persistent AI orchestrator memory (insights, prior recommendations, patterns).
model AiMemoryEntry {
  id             String    @id @default(cuid())
  organizationId String
  assetId        String?
  auditId        String?
  key            String
  kind           String
  content        Json      @default("{}")
  promptVersion  String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  audit        Audit?       @relation(fields: [auditId], references: [id], onDelete: SetNull)

  @@unique([organizationId, assetId, key])
  @@index([organizationId, kind])
  @@index([assetId])
  @@index([auditId])
  @@map("ai_memory_entries")
}

/// Recurring / scheduled audit automation.
model AuditSchedule {
  id               String    @id @default(cuid())
  organizationId   String
  assetId          String
  name             String
  /// Interval in minutes between runs (simple scheduler; cron later).
  intervalMinutes  Int       @default(10080)
  isActive         Boolean   @default(true)
  config           Json      @default("{}")
  maxAttempts      Int       @default(3)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  lastStatus       String?
  lastError        String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, isActive, nextRunAt])
  @@index([assetId])
  @@map("audit_schedules")
}

/// Structured retry/logging for automated workflows (schedules, integrations, reports).
model WorkflowLog {
  id             String   @id @default(cuid())
  organizationId String
  workflowType   String
  referenceId    String?
  attempt        Int      @default(1)
  status         String
  message        String?
  meta           Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, workflowType, createdAt])
  @@index([referenceId])
  @@map("workflow_logs")
}

/// Team collaboration comments on an audit.
model AuditComment {
  id             String   @id @default(cuid())
  organizationId String
  auditId        String
  authorId       String
  body           String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent       AuditComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      AuditComment[] @relation("CommentThread")

  @@index([auditId, createdAt])
  @@index([organizationId])
  @@map("audit_comments")
}

/// ShotLuma-style screenshot studio projects and custom marketing visual configurations.
model ScreenshotStudioProject {
  id             String   @id @default(cuid())
  organizationId String
  assetId        String?
  createdById    String
  name           String
  platform       String   @default("ios")
  canvasConfig   Json     @default("{}")
  exportSettings Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([createdById])
  @@map("screenshot_studio_projects")
}

