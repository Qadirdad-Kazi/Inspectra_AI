{
  "name": "@inspectra/ai-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@inspectra/ai-intelligence": "workspace:^",
    "@inspectra/audit-contracts": "workspace:*",
    "@inspectra/logger": "workspace:*",
    "@inspectra/redaction": "workspace:*",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@inspectra/tsconfig": "workspace:*",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
