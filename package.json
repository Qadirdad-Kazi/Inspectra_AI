{
  "name": "inspectra",
  "private": true,
  "version": "0.0.0",
  "description": "Inspectra AI — multi-target audit platform monorepo",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @inspectra/db generate",
    "db:migrate": "pnpm --filter @inspectra/db migrate:dev",
    "db:push": "pnpm --filter @inspectra/db push",
    "db:studio": "pnpm --filter @inspectra/db studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "build:api:render": "pnpm --filter @inspectra/db generate && pnpm --filter @inspectra/api... build",
    "build:web:vercel": "bash scripts/vercel-web-build.sh"
  },
  "dependencies": {
    "@inspectra/sdk": "workspace:*",
    "@inspectra/ui": "workspace:*",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.6",
    "lucide-react": "^1.28.0",
    "next": "~15.5.22",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@inspectra/eslint-config": "workspace:*",
    "@inspectra/tsconfig": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
