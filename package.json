{
  "name": "inspectra",
  "private": true,
  "version": "0.0.0",
  "description": "Inspectra AI \u2014 multi-target audit platform monorepo",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @inspectra/db generate",
    "db:migrate": "pnpm --filter @inspectra/db migrate:dev",
    "db:push": "pnpm --filter @inspectra/db push",
    "db:studio": "pnpm --filter @inspectra/db studio",
    "clean": "turbo run clean && rm -rf node_modules",
    "build:api:render": "pnpm --filter @inspectra/db generate && pnpm --filter @inspectra/api... build"
  },
  "devDependencies": {
    "@inspectra/eslint-config": "workspace:*",
    "@inspectra/tsconfig": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
